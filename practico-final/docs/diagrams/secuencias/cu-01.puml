skinparam backgroundColor #FEFEFE
actor Recepcionista as recep
participant "FormularioOdontologico" as ui
participant "PestaniaPacientes" as pest
participant "Consultorio" as db
database "SQLite" as sql

recep -> ui : Selecciona pestaña\n"Registrar Paciente"
ui -> pest : Muestra formulario vacío

recep -> pest : Completa campos\ny presiona Guardar
pest -> db : registrar_paciente(datos)
