db -> pest : return Paciente
pest -> pest : refrescar_listado()
pest -> db : listar_pacientes()
db -> sql : SELECT ... WHERE activo=1
db -> pest : return list[Paciente]
pest -> ui : Actualiza Treeview
pest -> recep : Muestra mensaje de éxito

@enduml
